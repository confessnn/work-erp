<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 전체 틀. 머리(달 이동) + 요일 줄 + 주 단위 칸(코드에서 채움) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/prev"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="◀"
            android:textColor="@color/fg"
            android:textSize="13sp"
            android:contentDescription="@string/prev_month" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/fg"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="@color/fg"
            android:textSize="13sp"
            android:contentDescription="@string/next_month" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="2dp" />

    <!-- 구분선. RemoteViews 는 @RemoteView 가 붙은 뷰만 펼칠 수 있어서
         plain View 를 쓰면 '위젯을 추가할 수 없습니다' 가 된다. ImageView 는 허용된다. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/weeks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2dp"
        android:textColor="@color/muted"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>

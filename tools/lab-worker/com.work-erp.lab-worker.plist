<?xml version="1.0" encoding="UTF-8"?>
<!-- 맥을 켜면 연구소 워커가 저절로 돌게 한다.
     ~/Library/LaunchAgents/ 로 복사한 뒤 아래 경로 두 곳(<내홈>)을 실제 경로로 바꾸고
     launchctl load ~/Library/LaunchAgents/com.work-erp.lab-worker.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.work-erp.lab-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/&lt;내홈&gt;/Desktop/work-erp/tools/lab-worker/worker.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/&lt;내홈&gt;/Library/Logs/lab-worker.log</string>
  <key>StandardErrorPath</key><string>/Users/&lt;내홈&gt;/Library/Logs/lab-worker.log</string>
</dict>
</plist>

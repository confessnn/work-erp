# Supabase 프로젝트 (공개 키라서 노출돼도 되지만, .env.local 에 넣어 사용)
NEXT_PUBLIC_SUPABASE_URL=https://ggisybrvmxjkolzwmlux.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_H932l7X1fYWtv-xAyjADpg_2pXj6Cq1

# 아래는 비밀값: Vercel 환경변수(sensitive)에만 넣고 여기엔 값을 쓰지 않는다
# CRON_SECRET=            # 매일 캘린더 자동 불러오기 (DB에는 sha256만 저장: private.app_secrets)
# GOOGLE_CLIENT_ID=       # 구글 클라우드 OAuth 클라이언트 (구글 캘린더 내보내기)
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_KEY=       # refresh token 암호화 키, base64 32바이트 (openssl rand -base64 32)
# BID_API_KEY=           # 공공데이터포털 조달청_나라장터 입찰공고정보서비스 일반 인증키 (공고 수신함)
# ANTHROPIC_API_KEY=     # Claude API 키 (원가 공고 첨부 요약)
# ANTHROPIC_ADMIN_KEY=   # Claude Console 조직 관리자 키, sk-ant-admin 으로 시작 (API 크레딧 사용액)
# OPENAI_ADMIN_KEY=      # OpenAI 관리자 키, sk-admin- 으로 시작, 읽기 전용 (API 크레딧 사용액)
# RESEND_API_KEY=        # Resend 키, re_ 로 시작 (아침 공고 메일)
# BID_NOTIFY_EMAIL=      # 공고 메일 받을 주소. Resend 가입 메일과 같아야 한다
